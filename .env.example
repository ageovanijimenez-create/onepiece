# Copia este fichero a .env.local y rellena el valor.
#
# Sin ADMIN_TOKEN el panel /admin no existe: devuelve 404. Es a propósito,
# falla cerrado. Pon algo largo y aleatorio, no una contraseña que uses.
ADMIN_TOKEN=

# Opcional: ruta de la base SQLite. Por defecto data/opvault.sqlite
# DB_PATH=

# Opcional: User-Agent con el que nos identificamos ante TCGCSV.
# USER_AGENT=

# Opcional: id de One Piece en Cardmarket (18) y en TCGplayer/TCGCSV (68).
# Solo hace falta tocarlos si alguno de los dos lo cambia algún día: la
# ingesta comprueba que lo descargado es One Piece y avisa si no.
# CARDMARKET_GAME=18
# TCGCSV_CATEGORY=68
